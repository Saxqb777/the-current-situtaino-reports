# Free key from https://aisstream.io (sign in with GitHub, then "API Keys").
# Without it the chart shows ports, zones and news, but no live ships.
AISSTREAM_API_KEY=

# Postgres connection string (Neon). Without it data lives in memory,
# which is fine on your own machine but is lost between requests on Vercel.
DATABASE_URL=

# Seconds each refresh listens to the ship feed (default 30).
AIS_SAMPLE_SECONDS=30

# Optional: Unifeeder vessels to highlight, comma-separated. Ships whose
# name starts with "Unifeeder" are matched without this.
UNIFEEDER_MMSI=
UNIFEEDER_NAMES=

# Set to 1 to load the bundled sample events for design review only.
# The UI shows a "Sample data" banner whenever this is on.
SAMPLE_DATA=0
