# Free key from https://aisstream.io (sign in with GitHub, then "API Keys").
# Without it the chart shows ports, zones and news, but no live ships.
AISSTREAM_API_KEY=

# How often to poll news sources, in seconds (default 120).
NEWS_POLL_SECONDS=120

# Set to 1 to load the bundled sample events for design review only.
# The UI shows a "Sample data" banner whenever this is on.
SAMPLE_DATA=0
